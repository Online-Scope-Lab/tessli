    "mcp": "node mcp/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs && node scripts/check-intelligence-profiles.mjs && node scripts/check-source-profile-contract.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "next": "16.2.12",
    "react": "^19.2.0",
