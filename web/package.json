{
  "name": "tessli-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "catalogue:generate": "node scripts/generate-catalogue.mjs",
    "catalogue:check": "node scripts/check-catalogue.mjs",
    "check:hero": "node scripts/check-hero.mjs",
    "profiles:check": "node scripts/check-intelligence-profiles.mjs",
    "source-profiles:check": "node scripts/check-source-profile-contract.mjs",
    "mcp": "node mcp/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs && node scripts/check-intelligence-profiles.mjs && node scripts/check-source-profile-contract.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run check:hero && npm run format:check && npm run typecheck && npm run lint && npm test && npm run catalogue:check && npm run registry:check && npm run build",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:check": "node scripts/build-registry.mjs --check",
    "test:items": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.2.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "8.17.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.12",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.1.0",
    "yaml": "2.9.1"
  }
}
