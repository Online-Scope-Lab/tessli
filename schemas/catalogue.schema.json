{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tessli:schema:catalogue:v1",
  "title": "Tessli Catalogue",
  "description": "Generated catalogue: every source from sources/*.yml (archived ones included, with their status), the categories, and the curated collections.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source", "resources", "categories", "collections"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 2
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "fileCount"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fileCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Optional build metadata. Omit from deterministic committed catalogue output."
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/collection"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "absoluteHttpUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "name",
        "url",
        "domain",
        "description",
        "category",
        "kind",
        "access",
        "status",
        "addedAt",
        "addedVia",
        "lastChecked"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "slug": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "url": {
          "$ref": "#/$defs/absoluteHttpUrl"
        },
        "domain": {
          "description": "Derived from url at build time.",
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9.-]+$"
        },
        "description": {
          "description": "The source file's summary.",
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "category": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "type": "string",
          "enum": [
            "gallery",
            "library",
            "design-system",
            "tool",
            "asset",
            "reference"
          ]
        },
        "access": {
          "type": "string",
          "enum": ["free", "freemium", "paid", "open-source", "free-trial"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "needs-review", "archived"]
        },
        "addedAt": {
          "type": "string",
          "format": "date"
        },
        "addedVia": {
          "type": "string",
          "enum": ["curator", "community"]
        },
        "lastChecked": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date"
            }
          ]
        },
        "frameworks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "bestFor": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "replacedBy": {
          "$ref": "#/$defs/identifier"
        },
        "archivedReason": {
          "type": "string",
          "minLength": 1
        },
        "submissionIssue": {
          "type": "integer",
          "minimum": 1
        },
        "faviconUrl": {
          "$ref": "#/$defs/absoluteHttpUrl"
        },
        "previewImageUrl": {
          "$ref": "#/$defs/absoluteHttpUrl"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "archived"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["archivedReason"]
          }
        }
      ]
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "shortLabel", "description", "icon", "order"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "shortLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "title",
        "description",
        "resourceIds",
        "coverStyle",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "slug": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "resourceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "coverStyle": {
          "type": "string",
          "enum": ["editorial", "typography", "motion", "systems"]
        },
        "curator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "profileUrl": {
              "$ref": "#/$defs/absoluteHttpUrl"
            }
          }
        },
        "lastReviewedAt": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "published", "archived"]
        }
      }
    }
  }
}
