{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tessli.dev/schemas/source-profile.schema.json",
  "title": "Tessli Source Profile",
  "description": "Canonical source identity, normalized research fields, status and optional intelligence profile consumed by Tessli website and MCP surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "id",
    "slug",
    "name",
    "url",
    "domain",
    "summary",
    "category",
    "sourceType",
    "sourceTypeBasis",
    "accessModel",
    "bestFor",
    "capabilities",
    "contentObjects",
    "platforms",
    "frameworks",
    "integrationMethods",
    "accessRoutes",
    "limitations",
    "status",
    "archivedReason",
    "replacedBy",
    "intelligence"
  ],
  "properties": {
    "contractVersion": {
      "type": "integer",
      "const": 2
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "slug": {
      "$ref": "#/$defs/identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "category": {
      "$ref": "#/$defs/identifier"
    },
    "sourceType": {
      "type": "string",
      "enum": [
        "inspiration-directory",
        "product-reference-library",
        "marketing-reference-library",
        "implementation-library",
        "design-system",
        "creative-technology-resource",
        "typography-resource",
        "color-accessibility-resource",
        "icon-library",
        "visual-asset-library",
        "design-ai-tool"
      ]
    },
    "sourceTypeBasis": {
      "type": "string",
      "const": "category-classification"
    },
    "accessModel": {
      "$ref": "#/$defs/accessModel"
    },
    "bestFor": {
      "$ref": "https://tessli.dev/schemas/resource-intelligence-profile.schema.json#/properties/workflowFit"
    },
    "capabilities": {
      "$ref": "https://tessli.dev/schemas/resource-intelligence-profile.schema.json#/properties/capabilities"
    },
    "contentObjects": {
      "$ref": "https://tessli.dev/schemas/resource-intelligence-profile.schema.json#/properties/contentObjects"
    },
    "platforms": {
      "$ref": "https://tessli.dev/schemas/resource-intelligence-profile.schema.json#/properties/platforms"
    },
    "frameworks": {
      "$ref": "https://tessli.dev/schemas/resource-intelligence-profile.schema.json#/properties/frameworks"
    },
    "integrationMethods": {
      "$ref": "https://tessli.dev/schemas/resource-intelligence-profile.schema.json#/properties/integrationMethods"
    },
    "accessRoutes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/accessRoute" }
    },
    "limitations": {
      "$ref": "https://tessli.dev/schemas/resource-intelligence-profile.schema.json#/properties/limitations"
    },
    "status": {
      "type": "string",
      "enum": ["active", "needs-review", "archived"]
    },
    "archivedReason": {
      "description": "Required text when status is archived; null otherwise.",
      "type": ["string", "null"],
      "minLength": 1
    },
    "replacedBy": {
      "description": "Slug of the source that replaces an archived one, or null.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/identifier" }]
    },
    "intelligence": {
      "anyOf": [
        { "type": "null" },
        {
          "$ref": "https://tessli.dev/schemas/resource-intelligence-profile.schema.json"
        }
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "accessModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access"],
      "properties": {
        "access": {
          "type": "string",
          "enum": ["free", "freemium", "paid", "open-source", "free-trial"]
        }
      }
    },
    "accessRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "preferred", "auth", "agentAction"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["browser", "documentation", "package-registry", "source-code", "api", "mcp", "cli", "plugin"]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "preferred": { "type": "boolean" },
        "auth": { "type": "string", "enum": ["none", "user", "unknown"] },
        "agentAction": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
