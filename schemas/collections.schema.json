{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tessli:schema:launch-playbooks:v2",
  "title": "Tessli Launch Playbooks",
  "description": "Repository-maintained public Playbook source with staged research guidance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "collections"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 2
    },
    "collections": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/collection"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "stageItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceId", "role"],
      "properties": {
        "resourceId": {
          "$ref": "#/$defs/identifier"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "inspect", "decision", "items"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "inspect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "decision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/stageItem"
          }
        }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "title",
        "description",
        "outcome",
        "audience",
        "resourceIds",
        "stages",
        "coverStyle",
        "lastReviewedAt",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "slug": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "outcome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "resourceIds": {
          "type": "array",
          "minItems": 5,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "stages": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/stage"
          }
        },
        "coverStyle": {
          "type": "string",
          "enum": ["editorial", "typography", "motion", "systems"]
        },
        "lastReviewedAt": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "type": "string",
          "const": "published"
        }
      }
    }
  }
}
